# Copier ce fichier en .env.production et remplir les valeurs réelles
# Ne jamais committer .env.production dans git

NODE_ENV=production
PORT=3001

# Frontend
FRONTEND_URL=https://altotrailer.com

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REMPLACER_PAR_UNE_CHAINE_ALEATOIRE_DE_64_OCTETS_MINIMUM

# MySQL Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_NAME=REMPLACER
DB_USER=REMPLACER
DB_PASSWORD=REMPLACER

# Coordonnées bancaires SEPA (affichées au client après commande)
BANK_BENEFICIAIRE=LA REMORQUE M
BANK_IBAN=FR76 XXXX XXXX XXXX XXXX XXXX XXX
BANK_BIC=XXXXXXXXX
BANK_NAME=REMPLACER

# SMTP Hostinger
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@altotrailer.com
SMTP_PASS=REMPLACER
SMTP_FROM=info@altotrailer.com
SMTP_ADMIN=info@altotrailer.com
