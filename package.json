{
  "name": "nexustrailer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --port 5187\" \"node --watch server/index.js\" --names \"vite,api\" --prefix-colors \"cyan,yellow\"",
    "dev:frontend": "vite --port 5187",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "setup:admin": "node server/create-admin.js",
    "db:seed": "node server/sql/seed.js",
    "db:settings": "node server/sql/create-settings.js",
    "start:prod": "node server/index.js"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bootstrap-icons": "^1.13.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^5.9.6",
    "morgan": "^1.12.1",
    "mysql2": "^3.23.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.20.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "@vitejs/plugin-react": "^6.0.4",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.1.2",
    "oxlint": "^1.75.0"
  }
